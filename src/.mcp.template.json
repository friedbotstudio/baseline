{
  "mcpServers": {
    "gitmcp": {
      "type": "http",
      "url": "https://gitmcp.io/docs"
    },
    "plantuml": {
      "command": "npx",
      "args": ["-y", "plantuml-mcp-server"],
      "env": {
        "PLANTUML_SERVER_URL": "https://www.plantuml.com/plantuml"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser", "chrome",
        "--isolated"
      ]
    },
    "baseline": {
      "command": "node",
      "args": [".claude/mcp/baseline/server.mjs"]
    }
  }
}
