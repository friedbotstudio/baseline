  <g class="dg-box">
    <rect x="0" y="172" width="170" height="32" vector-effect="non-scaling-stroke"/>
    <rect x="0" y="216" width="170" height="32" vector-effect="non-scaling-stroke"/>
    <rect x="0" y="260" width="170" height="32" vector-effect="non-scaling-stroke"/>
  </g>
  <g class="dg-node">
    <text x="14" y="193">p2</text>
    <text x="14" y="237">p3</text>
