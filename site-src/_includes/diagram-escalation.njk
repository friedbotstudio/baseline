  </g>
  <g class="dg-note">
    <text x="182" y="193">decide</text>
    <text x="182" y="237">in-lane</text>
  </g>

  <g class="dg-spine"><path d="M40 292v22M40 314h240" vector-effect="non-scaling-stroke"/></g>
  <g class="dg-lane"><text x="0" y="344">broker</text></g>
  <g class="dg-note"><text x="0" y="372">.claude/state/sprint/&lt;channel&gt;/</text></g>
</svg>
