{# Velocity hero symbol: what a gate may skip, and what it structurally cannot.
   A phase run reads left to right. Two cells are dashed and struck through: the
   cleanup passes a small diff does not warrant, which the gate may skip. The
   middle cell is filled and carries a lock rule beneath it: the security review
   is not in the skip set at all, so it is unreachable rather than merely
   unlikely. The measure bar underneath shows what the decision is made from,
   which is a count, not a judgment. Vocabulary: filled = never skippable,
   dashed = eligible to skip, accent = the boundary the gate cannot cross.
   Styled inline with the shared design tokens; no bespoke stylesheet. #}
<svg class="hero-symbol-svg velocity-svg" viewBox="0 0 360 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="velocity-title">
  <title id="velocity-title">A phase sequence in which two cleanup passes are dashed and struck through as skippable, while the security review sits filled and unskippable between them. A measure bar beneath shows the decision comes from counting files and lines.</title>

  <text x="180" y="46" text-anchor="middle" style="font-family: var(--mono); font-size: 12px; fill: var(--muted); letter-spacing: .04em;">after the code phase</text>

  {# Skippable: simplify. #}
  <rect x="26" y="76" width="88" height="58" rx="4" fill="var(--paper)" stroke="var(--charcoal)" stroke-width="1.25" stroke-dasharray="4 3"/>
  <text x="70" y="110" text-anchor="middle" style="font-family: var(--mono); font-size: 11.5px; fill: var(--muted); letter-spacing: .04em;">simplify</text>
  <line x1="38" y1="105" x2="102" y2="105" stroke="var(--muted)" stroke-width="1.25"/>

  {# Not skippable: security. Filled, and fenced by accent. #}
  <rect x="136" y="76" width="88" height="58" rx="4" fill="var(--ink)"/>
  <text x="180" y="110" text-anchor="middle" style="font-family: var(--mono); font-size: 11.5px; fill: var(--paper); letter-spacing: .04em;">security</text>

  {# Skippable: document. #}
  <rect x="246" y="76" width="88" height="58" rx="4" fill="var(--paper)" stroke="var(--charcoal)" stroke-width="1.25" stroke-dasharray="4 3"/>
  <text x="290" y="110" text-anchor="middle" style="font-family: var(--mono); font-size: 11.5px; fill: var(--muted); letter-spacing: .04em;">document</text>
  <line x1="258" y1="105" x2="322" y2="105" stroke="var(--muted)" stroke-width="1.25"/>

  {# The fence: accent brackets around the cell the skip set cannot contain. #}
  <path d="M128 68 L124 68 L124 142 L128 142" fill="none" stroke="var(--accent)" stroke-width="1.5"/>
  <path d="M232 68 L236 68 L236 142 L232 142" fill="none" stroke="var(--accent)" stroke-width="1.5"/>
  <text x="180" y="164" text-anchor="middle" style="font-family: var(--mono); font-size: 11px; fill: var(--accent); letter-spacing: .04em;">not in the skip set</text>

  {# The measure: what the decision is actually made from. #}
  <line x1="26" y1="228" x2="334" y2="228" stroke="var(--rule)" stroke-width="1"/>
  <text x="26" y="216" style="font-family: var(--mono); font-size: 11px; fill: var(--muted); letter-spacing: .04em;">measured</text>

  <rect x="26" y="244" width="120" height="26" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.25"/>
  <text x="86" y="261" text-anchor="middle" style="font-family: var(--mono); font-size: 11px; fill: var(--ink); letter-spacing: .04em;">files</text>

  <rect x="158" y="244" width="120" height="26" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.25"/>
  <text x="218" y="261" text-anchor="middle" style="font-family: var(--mono); font-size: 11px; fill: var(--ink); letter-spacing: .04em;">lines</text>

  <rect x="290" y="244" width="44" height="26" fill="var(--paper)" stroke="var(--charcoal)" stroke-width="1.25" stroke-dasharray="4 3"/>
  <text x="312" y="261" text-anchor="middle" style="font-family: var(--mono); font-size: 11px; fill: var(--muted); letter-spacing: .04em;">tests</text>
  <line x1="296" y1="257" x2="328" y2="257" stroke="var(--muted)" stroke-width="1.25"/>

  <text x="180" y="300" text-anchor="middle" style="font-family: var(--mono); font-size: 11px; fill: var(--muted); letter-spacing: .04em;">test lines excluded from the measure</text>

  <text x="180" y="344" text-anchor="middle" style="font-family: var(--mono); font-size: 13px; fill: var(--muted); letter-spacing: .04em;">counted, never judged</text>
</svg>
