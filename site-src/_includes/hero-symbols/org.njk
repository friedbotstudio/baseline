{# Org-mode hero symbol: a flat pod, one relay, one authority.
   Four peer sessions sit as a flat pod and coordinate through a central broker
   diamond. Three are outline workers; one is the accent lead. An accent arrow
   rises from the lead to the filled human anchor at the top, tracing the
   escalation chain peer -> lead -> human. Vocabulary: filled = decision
   authority (the human), outline = a peer session doing bounded work, accent =
   the lead (the active relay), charcoal connectors = broker coordination.
   Styled inline with the shared design tokens; no bespoke stylesheet. #}
<svg class="hero-symbol-svg org-svg" viewBox="0 0 360 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="org-title">
  <title id="org-title">A flat pod of four peer sessions coordinating through a central broker, with one accent lead relaying an escalation up to the filled human anchor at the top.</title>
  <defs>
    <marker id="org-arr-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="var(--accent)"/>
    </marker>
  </defs>

  {# Human anchor: filled authority at the top. #}
  <text x="180" y="34" text-anchor="middle" style="font-family: var(--mono); font-size: 12px; fill: var(--ink); letter-spacing: .04em;">human</text>
  <circle cx="180" cy="58" r="11" fill="var(--ink)"/>

  {# Escalation relay: accent arrow from the lead up to the human. #}
  <line x1="180" y1="150" x2="180" y2="73" stroke="var(--accent)" stroke-width="1.5" marker-end="url(#org-arr-acc)"/>

  {# Lead peer: accent, the active relay. #}
  <rect x="142" y="150" width="76" height="46" rx="4" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.5"/>
  <text x="180" y="178" text-anchor="middle" style="font-family: var(--mono); font-size: 12px; fill: var(--accent); letter-spacing: .04em;">lead</text>

  {# Broker hub: central coordination point the whole pod links to. #}
  <line x1="180" y1="196" x2="180" y2="223" stroke="var(--charcoal)" stroke-width="1.25"/>
  <g transform="rotate(45 180 240)">
    <rect x="163" y="223" width="34" height="34" rx="3" fill="var(--paper)" stroke="var(--charcoal)" stroke-width="1.25"/>
  </g>
  <text x="216" y="244" style="font-family: var(--mono); font-size: 12px; fill: var(--muted); letter-spacing: .04em;">broker</text>

  {# The other three peers: outline workers, each its own lane. #}
  <rect x="36"  y="288" width="72" height="46" rx="4" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.25"/>
  <rect x="144" y="288" width="72" height="46" rx="4" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.25"/>
  <rect x="252" y="288" width="72" height="46" rx="4" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.25"/>
  <text x="72"  y="316" text-anchor="middle" style="font-family: var(--mono); font-size: 12px; fill: var(--charcoal); letter-spacing: .04em;">peer</text>
  <text x="180" y="316" text-anchor="middle" style="font-family: var(--mono); font-size: 12px; fill: var(--charcoal); letter-spacing: .04em;">peer</text>
  <text x="288" y="316" text-anchor="middle" style="font-family: var(--mono); font-size: 12px; fill: var(--charcoal); letter-spacing: .04em;">peer</text>

  {# Coordination connectors: each peer to the broker hub. #}
  <line x1="72"  y1="288" x2="171" y2="252" stroke="var(--charcoal)" stroke-width="1.25"/>
  <line x1="180" y1="288" x2="180" y2="258" stroke="var(--charcoal)" stroke-width="1.25"/>
  <line x1="288" y1="288" x2="189" y2="252" stroke="var(--charcoal)" stroke-width="1.25"/>

  {# Caption. #}
  <text x="180" y="352" text-anchor="middle" style="font-family: var(--mono); font-size: 13px; fill: var(--muted); letter-spacing: .04em;">peers decide · lead relays · human decides</text>
</svg>
