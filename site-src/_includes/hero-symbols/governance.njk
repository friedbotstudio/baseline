{# Governance hero symbol: the precedence chain, and its two different resolutions.
   Four stacked strata, each governing the one below. The top stratum is filled
   (genesis holds final authority); the rest are outline. The two arrows differ
   deliberately: between the lower three, an ink arrow points DOWN, because a
   disagreement there is settled automatically (disk is measured against the rule
   and corrected). Between genesis and constitution, an accent arrow points UP and
   terminates in a halt bar, because that conflict has no automatic answer and the
   session stops instead. Vocabulary: filled = final authority, outline = governed,
   accent = the seam where a human is required. Styled inline with the shared
   design tokens; no bespoke stylesheet. #}
<svg class="hero-symbol-svg governance-svg" viewBox="0 0 360 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="governance-title">
  <title id="governance-title">Four stacked layers of authority: genesis governs the constitution, which governs the annex, which governs the implementation on disk. A downward ink arrow marks the conflicts that resolve automatically; an upward accent arrow ending in a halt bar marks the one conflict that stops for a human.</title>
  <defs>
    <marker id="gov-arr-ink" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="var(--ink)"/>
    </marker>
  </defs>

  {# I. Genesis: filled, final authority. #}
  <g class="gov-form gov-i"><rect x="96" y="34" width="168" height="44" fill="var(--ink)"/>
  <text x="180" y="62" text-anchor="middle" style="font-family: var(--mono); font-size: 12px; fill: var(--paper); letter-spacing: .04em;">genesis</text></g>

  {# The halt seam: accent, upward, stopping at a bar. No automatic resolution here. #}
  <line x1="180" y1="112" x2="180" y2="88" stroke="var(--accent)" stroke-width="1.5"/>
  <line x1="164" y1="88" x2="196" y2="88" stroke="var(--accent)" stroke-width="2"/>
  <text x="208" y="104" style="font-family: var(--mono); font-size: 11px; fill: var(--accent); letter-spacing: .04em;">halt</text>

  {# II. Constitution. #}
  <g class="gov-form gov-ii"><rect x="96" y="112" width="168" height="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5"/>
  <text x="180" y="140" text-anchor="middle" style="font-family: var(--mono); font-size: 12px; fill: var(--ink); letter-spacing: .04em;">constitution</text></g>

  <line x1="180" y1="156" x2="180" y2="186" stroke="var(--ink)" stroke-width="1.25" marker-end="url(#gov-arr-ink)"/>

  {# III. Annex. #}
  <g class="gov-form gov-iii"><rect x="96" y="190" width="168" height="44" fill="var(--paper)" stroke="var(--charcoal)" stroke-width="1.25"/>
  <text x="180" y="218" text-anchor="middle" style="font-family: var(--mono); font-size: 12px; fill: var(--charcoal); letter-spacing: .04em;">annex</text></g>

  <line x1="180" y1="234" x2="180" y2="264" stroke="var(--ink)" stroke-width="1.25" marker-end="url(#gov-arr-ink)"/>

  {# IV. Implementation: the layer that loses and gets corrected. #}
  <g class="gov-form gov-iv"><rect x="96" y="268" width="168" height="44" fill="var(--paper)" stroke="var(--charcoal)" stroke-width="1.25" stroke-dasharray="4 3"/>
  <text x="180" y="296" text-anchor="middle" style="font-family: var(--mono); font-size: 12px; fill: var(--charcoal); letter-spacing: .04em;">implementation</text></g>

  <text x="180" y="344" text-anchor="middle" style="font-family: var(--mono); font-size: 13px; fill: var(--muted); letter-spacing: .04em;">below, corrected · above, surfaced</text>
</svg>
