<footer class="site">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand-col">
        <a class="brand" href="{{ '/' | rel }}">
          <span class="dot"></span><span>{{ site.brand }}</span>
        </a>
        <p class="footer-tagline">{{ site.tagline }}</p>
        <p class="footer-attribution">Product of <a target="_blank" href="https://friedbotstudio.com?utm_source=baseline&utm_medium=cta&utm_campaign=footer">Friedbot Studio Private Limited</a></p>
      </div>
      {# Mirrors nav.primary so every top-level destination is reachable from the
         bottom of any page. The prior list carried five of ten and silently
         stranded install, workflows, cli, pm and org. #}
      <div class="footer-col">
        <h5>Docs</h5>
        <ul>
          {%- for item in nav.primary %}{% if item.key != "overview" %}
          <li><a href="{{ item.href | rel }}">{{ item.label }}</a></li>
          {%- endif %}{% endfor %}
        </ul>
      </div>
      <div class="footer-col">
        <h5>Project</h5>
        <ul>
          <li><a href="{{ site.repo }}">GitHub</a></li>
          <li><a href="{{ site.repo }}/blob/main/CLAUDE.md">Constitution</a></li>
          <li><a href="{{ site.repo }}/blob/main/LICENSE">License</a></li>
          <li><a href="{{ site.repo }}/issues">Issues</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-meta-row">
      <span>© {{ site.year }} {{ site.brand }} · Apache 2.0-licensed</span>
      <span>{{ site.version }} · updated {{ site.lastUpdated }} · build {{ build.build_id }}</span>
    </div>
  </div>
</footer>
