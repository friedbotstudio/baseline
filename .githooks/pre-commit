#!/usr/bin/env bash
# Baseline CI posture pre-commit hook.
#
# Activate once per clone (manual step — never automated; CLAUDE.md Art. VII
# forbids `git config` automation):
#
#   git config core.hooksPath .githooks
#
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
# Called, not exec'd: this hook ships to consumer projects as a starting point,
# and `exec` replaces the shell, so any check a project appends below would be
# silently skipped. `set -e` above still aborts the commit on a non-zero exit.
"$repo_root/scripts/ci/require-gitleaks.sh"
