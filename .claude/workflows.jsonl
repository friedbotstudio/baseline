n": ["research"], "blocks": ["spec-shippability-review"], "can_parallel": false, "needs_user": false, "activeForm": "Running spec", "metadata": {"phase": "spec"}}, {"id": "spec-shippability-review", "type": "task", "skill": "spec-shippability-review", "depends_on": ["spec"], "blocks": ["approve-direction"], "can_parallel": false, "needs_user": false, "activeForm": "Reviewing spec shippability", "metadata": {"phase": "spec-shippability-review"}}, {"id": "approve-direction", "type": "task", "skill": "approve-direction", "depends_on": ["spec-shippability-review"], "blocks": ["memory-sync"], "can_parallel": false, "needs_user": true, "activeForm": "Awaiting direction approval", "metadata": {"phase": "approve-direction", "needs_user": true}}, {"id": "memory-sync", "type": "task", "skill": "memory-sync", "depends_on": ["approve-direction"], "blocks": ["grant-commit"], "can_parallel": false, "needs_user": false, "activeForm": "Running memory-sync", "metadata": {"phase": "memory-sync"}}, {"id": "grant-commit", "type": "task", "skill": "grant-commit", "condition": {"name": "requires_commit_consent"}, "depends_on": ["memory-sync"], "blocks": ["commit"], "can_parallel": false, "needs_user": true, "activeForm": "Awaiting commit consent", "metadata": {"phase": "grant-commit", "needs_user": true}}, {"id": "commit", "type": "task", "skill": "commit", "depends_on": ["grant-commit"], "blocks": [], "can_parallel": false, "needs_user": false, "activeForm": "Running commit", "metadata": {"phase": "commit"}}]}
{"$schema": "./schemas/workflow-track.v1.json", "track_id": "epic-child", "name": "Epic child (inherited discovery)", "description": "Fast implementation path for ONE slice of an approved epic (seed.md \u00a718.9). Inherits + pins the epic's scout/research/spec; the discovery skip is enforced by track_guard, which blocks every write until the named epic's direction-approval token (.claude/state/spec_approvals/<epic>.approval) exists and pinned_artifacts (scout/research/spec) resolve. The epic state's approved boolean is NOT read for authorization. Declared DAG is tdd \u2192 simplify \u2192 security \u2192 integrate \u2192 document \u2192 archive \u2192 memory-sync \u2192 grant-commit \u2192 commit, of which simplify/security/document are written to workflow.json\u2192exceptions BY DEFAULT (effective fast path tdd \u2192 integrate \u2192 archive \u2192 grant-commit \u2192 commit). /triage escalates a review phase into the child \u2014 removing it from exceptions \u2014 only when the slice's risk warrants (security: auth/IO/untrusted-input/security.sensitive_globs; simplify: >1 layer or >simplify.min_files files; document: public API/CLI/docs change). /tdd reads the pinned spec's \"## Slice <id>\" section as its contract. Auto-selected when an approved epic is active and the request matches an open slice.", "selectable": true, "selector_hints": ["implement one slice of an active epic", "epic subtask with inherited design", "child of an approved epic spec"], "preconditions": [], "invariants": ["commits"], "nodes": [{"id": "implementation", "type": "selector", "alternates": [{"sub_track": "swarm-implementation", "preconditions": [{"name": "requires_git"}, {"name": "requires_min_components", "argument": "1"}], "description": "Swarm path for git projects with 1+ independent components"}, {"sub_track": "tdd-worker-chain", "preconditions": [], "description": "Solo TDD fallback"}], "can_parallel": false, "needs_user": false, "depends_on": [], "blocks": ["simplify"]}, {"id": 