{
  "$schema_version": 1,
  "configured": true,
  "gitignore": {
    "extra_must_ignore": []
  },
  "test": {
    "cmd": "node .claude/skills/audit-baseline/audit.mjs --file={file}",
    "kind": "structural",
    "affected_resolver": null,
    "file_globs": [
      "**/*"
    ],
    "timeout_seconds": 120
  },
  "lint": {
    "cmd": null,
    "file_globs": [
      "**/*"
    ],
    "timeout_seconds": 60
  },
  "tdd": {
    "enabled": true,
    "source_globs": [
      "src/**",
      "bin/**",
      "scripts/**",
      "site/assets/src/**",
      "site-src/_filters/**",
      ".claude/skills/**",
      ".claude/hooks/**"
    ],
    "test_globs": [
      "tests/**",
      "test/**",
      "spec/**",
      "__tests__/**",
      "**/*_test.*",
      "**/*.test.*",
      "**/*.spec.*"
    ],
    "mapping": "conventional",
    "exempt_globs": [
      "**/*.md",
      "**/*.json",
      "scripts/ci/*.sh",
      "**/*.yaml",
      "**/*.yml",
      "**/*.toml",
      "docs/**",
      ".claude/**",
      ".config/**",
      "src/**.template.*",
      "site/assets/brandmark*",
      "site/assets/favicon/**"
    ],
    "ui_globs": [
      "site-src/**",
      "app/**/*.{tsx,jsx}",
      "components/**/*.{tsx,jsx,vue,svelte}",
      "pages/**/*.{tsx,jsx,vue,svelte}",
      "src/**/*.{tsx,jsx,vue,svelte}",
      "**/*.html",
      "**/*.css",
      "**/*.scss",
      "**/*.njk"
    ]
  },
  "destructive": {
    "mode": "ask",
    "hard_block_patterns": [
      "^\\s*rm\\s+.*-[a-zA-Z]*r[a-zA-Z]*f[a-zA-Z]*\\s+/(\\s|$)",
      "^\\s*rm\\s+.*-[a-zA-Z]*f[a-zA-Z]*r[a-zA-Z]*\\s+/(\\s|$)",
      ":\\(\\)\\s*\\{\\s*:\\|:&\\s*\\};:",
      "\\bdd\\b.*of=/dev/(sd|nvme|hd|disk)",
      "\\bmkfs(\\.[a-z0-9]+)?\\b",
      "\\b(shutdown|halt|poweroff|reboot)\\b",
      ">\\s*/dev/sda",
      "\\bchmod\\s+-R\\s+000\\s+/"
    ],
    "ask_patterns": [
      "\\brm\\s+-[a-zA-Z]*r[a-zA-Z]*f[a-zA-Z]*\\b",
      "\\bgit\\s+reset\\s+--hard\\b",
      "\\bgit\\s+clean\\s+-[a-zA-Z]*f[a-zA-Z]*\\b",
      "\\bgit\\s+checkout\\s+--\\b",
      "\\bgit\\s+branch\\s+-D\\b",
      "\\bgit\\s+push\\s+.*(--force|--force-with-lease|-f\\b)",
      "\\bdrop\\s+(table|database|schema)\\b",
      "\\btruncate\\s+table\\b",
      "\\bkill\\s+-9\\b",
      "\\bchown\\s+-R\\b.*\\s/",
      "\\bnpm\\s+publish\\b",
      "\\bnpm\\s+version\\b",
      "\\bgit\\s+init\\b"
    ]
  },
  "workflow": {
    "phases": [
      "intake",
      "scout",
      "research",
      "spec",
      "review",
      "tdd",
      "simplify",
      "security",
      "integrate",
      "document",
      "commit"
    ],
    "optional_phases": [
      "security"
    ],
    "artifacts": {
      "intake": "docs/intake/*.md",
      "scout": "docs/scout/*.md",
      "research": "docs/research/*.md",
      "spec": "docs/specs/*.md",
      "review": ".claude/state/spec_approvals/*.approval",
      "tdd": null,
      "simplify": null,
      "security": "docs/security/*.md",
      "integrate": null,
      "document": "site/dist/**",
      "commit": null
    }
  },
  "artifacts": {
    "required_sections": {
      "intake": [
        "Problem",
        "Goal",
        "Acceptance criteria"
      ],
      "brd": [
        "Business objective",
        "Scope",
        "Business requirements"
      ],
      "spec": [
        "Goal",
        "Design",
        "Program design",
        "Design calls",
        "System delta",
        "Acceptance criteria",
        "Test plan"
      ],
      "rca": [
        "Summary",
        "Timeline",
        "Impact",
        "Root cause",
        "Action items"
      ]
    },
    "required_diagrams": {
      "spec": {
        "c4_context": {
          "min": 1,
          "marker": "!include <C4/C4_Context>"
        },
        "c4_container": {
          "min": 1,
          "marker": "!include <C4/C4_Container>"
        },
        "c4_component": {
          "min": 1,
          "marker": "!include <C4/C4_Component>"
        },
        "sequence": {
          "min": 1,
          "any_of": [
            "^\\s*participant\\b",
            "^\\s*actor\\b"
          ]
        },
        "class": {
          "min": 1,
          "any_of": [
            "^\\s*class\\s+\\w"
          ]
        },
        "dependency_graph": {
          "min": 1,
          "any_of": [
            "'\\s*@kind\\s+dependency-graph"
          ]
        }
      }
    },
    "compression": {
      "enabled": true
    },
    "subtick_timing": {
      "enabled": true
    },
    "diagram_profiles": [
      {
        "id": "non-architectural",
        "when": [
          ".claude/skills/**",
          "docs/**",
          "*.md",
          ".claude/*.json",
          ".claude/*.md",
          "src/*.template.md",
          "tests/**",
          "obj/**"
        ],
        "required_diagrams": {
          "c4_component": {
            "min": 1,
            "marker": "!include <C4/C4_Component>"
          },
          "class": {
            "min": 1,
            "any_of": [
              "^\\s*class\\s+\\w"
            ]
          },
          "sequence": {
            "min": 1,
            "any_of": [
              "^\\s*participant\\b",
              "^\\s*actor\\b"
            ]
          },
          "dependency_graph": {
            "min": 1,
            "any_of": [
              "'\\s*@kind\\s+dependency-graph"
            ]
          }
        }
      }
    ]
  },
  "consent": {
    "commit_ttl_seconds": 900,
    "workflow_ttl_seconds": 14400,
    "gate_marker_ttl_seconds": 120,
    "push_ttl_seconds": 300
  },
  "memory": {
    "thread_transform_ttl_seconds": 86400,
    "sharded_store": {
      "enabled": true,
      "activated_at": "2026-07-17",
      "rollback": "node .claude/skills/memory-index/migrate.mjs --reverse"
    },
    "workspace": {
      "enabled": true,
      "note": "Gates scout reconciliation against the structural corpus. Ships DEFAULT FALSE in src/project.template.json; enabled here because this repository is the canary and its corpus is seeded (rollout step 4). Flip false to roll back \u2014 scout returns to discovery and the corpus stays on disk, inert."
    },
    "architecture_map": {
      "enabled": true,
      "note": "Gates the concept layer, the four derived edge classes, and the session-start concept map. Ships ABSENT from src/project.template.json, so every consumer reads false; enabled here because this repository is the canary (spec D9). Flip false to roll back \u2014 by_concept lookups return [], renderConceptMap returns '', and the concepts/ and diagrams/ directories stay on disk, inert.",
      "governed_surface": {
        "roots": [
          ".claude/hooks/",
          ".claude/skills/",
          ".claude/commands/",
          ".claude/schemas/",
          ".claude/mcp/",
          ".github/workflows/",
          "src/"
        ],
        "codeExtensions": [
          ".mjs",
          ".js",
          ".json",
          ".yml"
        ],
        "alwaysIncluded": [
          ".claude/commands/"
        ],
        "excludedSegments": [
          "tests/",
          "test/",
          "fixtures/"
        ],
        "excludedTrees": [
          ".claude/skills/impeccable/",
          ".claude/skills/copywriting/evals/",
          ".claude/skills/optimize-seo/scripts/"
        ]
      },
      "witnesses": {
        "c4_context": {
          "witness": "anchor-digest"
        },
        "c4_container": {
          "witness": "anchor-digest"
        },
        "c4_component": {
          "witness": "anchor-digest"
        },
        "class": {
          "witness": "anchor-digest"
        },
        "dependency_graph": {
          "witness": "anchor-digest"
        },
        "sequence": {
          "witness": "test"
        },
        "activity": {
          "witness": "test"
        },
        "state_machine": {
          "witness": "test"
        }
      }
    },
    "annotations": {
      "enabled": true,
      "note": "Gates load_bearing-gated annotation placement by code-structure and annotation resolution by scout. Ships ABSENT in src/project.template.json, so every consumer reads false; enabled here because this repository is the canary (spec D7). Flip false to roll back \u2014 scout skips the scan, code-structure places nothing, and annotations already in source become inert text."
    }
  },
  "plantuml": {
    "strict_syntax_check": false
  },
  "git": {
    "workflow_model": "direct-to-main",
    "release_branches": [
      "main",
      "next"
    ],
    "protected_branches": null,
    "branch_pattern": null
  },
  "release": {
    "cicd_model": "github-actions",
    "release_branch": "main",
    "release_trigger": "on-push",
    "release_cycle": "continuous",
    "consumer_upgrade_cadence": "rare",
    "completeness_gate": {
      "enabled": true,
      "half_wired_blocks_release": true
    }
  },
  "swarm": {
    "max_parallel": 4,
    "granularity": "component",
    "min_tasks_worth_swarming": 1,
    "isolation": "shared",
    "refuse_dirty_tree": false,
    "exempt_path_prefixes": [
      ".claude/",
      ".git/",
      ".venv/",
      "node_modules/"
    ],
    "enforced_path_prefixes": [
      "src/",
      "lib/",
      "app/",
      "pkg/",
      "internal/",
      "tests/",
      "test/",
      "spec/",
      "docs/"
    ]
  },
  "epic": {
    "min_slices": 3
  },
  "tier": {
    "level": "regulated"
  },
  "simplify": {
    "min_files": 4
  },
  "security": {
    "sensitive_globs": [
      ".claude/hooks/**",
      ".claude/commands/**",
      "src/cli/**",
      "bin/**",
      "**/auth/**",
      "**/*.env*"
    ]
  },
  "velocity": {
    "rightsize": {
      "enabled": true,
      "max_lines": 80,
      "doc_globs": [
        "docs/**",
        "**/*.md",
        "src/cli/**",
        "bin/**"
      ]
    },
    "drift_reverify_skip": {
      "enabled": true
    },
    "checker_fanout": {
      "enabled": true,
      "checkers": [
        "spec-diagram",
        "spec-traceability",
        "spec-rollout"
      ]
    },
    "durable_plan": {
      "enabled": true
    },
    "code_review": {
      "enabled": true,
      "checkers": [
        "security",
        "simplify",
        "code-structure"
      ]
    },
    "design_judge": {
      "enabled": false
    },
    "sprint_mode": {
      "enabled": true
    },
    "org_mode": {
      "enabled": false
    },
    "power_mode": {
      "enabled": true
    },
    "notifier": {
      "enabled": true,
      "on_stop": "yielded",
      "attention": true,
      "presence": "aware",
      "present_idle_seconds": 60
    },
    "mutation_oracle": {
      "enabled": false
    },
    "ac_conformance": {
      "enabled": false
    }
  },
  "roadmap": {
    "path": "docs/roadmap-execution-plan.md"
  },
  "ci_posture": {
    "enabled": true
  },
  "whatsnew": {
    "route_workflow": null
  },
  "additions": {
    "agents": [],
    "skills": [],
    "hooks": [],
    "mcp_servers": [],
    "swarm_worker_skills": []
  },
  "document": {
    "surfaces": [
      {
        "match": [
          "site-src/**/*.njk"
        ],
        "kind": "public-page",
        "requires": [
          "technical-writer",
          "copywriting"
        ],
        "reader_target": 11,
        "note": "Rendered public pages only. site-src/_data/** is JSON/JS data, not prose, and owes no register."
      },
      {
        "match": [
          "docs/runbooks/**",
          "docs/references/**",
          "docs/*.md"
        ],
        "exclude": [
          "docs/roadmap-execution-plan.md"
        ],
        "kind": "doc-page",
        "requires": [
          "technical-writer"
        ],
        "reader_target": 11,
        "note": "Real documentation pages. docs/{specs,intake,scout,research,security,archive,brief,rca,tasklist,handoff,vision,design,audits,site,init}/ are WORKFLOW ARTIFACTS, not doc surfaces \u2014 they are excluded by omission from match. The roadmap is a machine-parsed tracker, not prose."
      },
      {
        "match": [
          "**/README.md"
        ],
        "exclude": [
          "docs/archive/**",
          "node_modules/**"
        ],
        "kind": "reference-section",
        "requires": [
          "prose"
        ],
        "reader_target": 11
      }
    ]
  }
}
